# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=sye_lodge
POSTGRES_USER=sye_lodge_app
DB_PASSWORD=change-me-strong-database-password

# --- Security ---------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
# Never change it after users have signed in.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Public address ---------------------------------------------------------
# APP_URL is used in email links and must be the final https:// address.
APP_URL=http://localhost:8080

# Production Compose stack only (docker-compose.prod.yml):
# SITE_ADDRESS is the hostname Caddy serves. Use your domain, an sslip.io name
# such as sye-lodge.203.0.113.10.sslip.io. Use ":80" only for a plain HTTP demo.
SITE_ADDRESS=:80
ACME_EMAIL=

# --- Demo content -----------------------------------------------------------
# true seeds 18 listings (12 featured), board posts and demo accounts.
DEMO_DATA=false
# Required only when DEMO_DATA=true; use a unique password and never commit it.
DEMO_PASSWORD=

# --- Email ------------------------------------------------------------------
# "console" writes emails, including OTP codes, to the container log.
MAIL_MODE=console
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=SYE Lodge <no-reply@example.com>

# Optional: comma-separated list of extra allowed browser origins
CORS_ORIGINS=
